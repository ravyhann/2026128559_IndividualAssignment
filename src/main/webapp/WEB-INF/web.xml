<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
    <welcome-file-list>
        <welcome-file>cvForm.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>CVServlet</servlet-name>
        <servlet-class>com.cvbuilder.controller.CVServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CVServlet</servlet-name>
        <url-pattern>/CVServlet</url-pattern>
    </servlet-mapping>
</web-app>